# Copy to .env. Expo inlines EXPO_PUBLIC_* variables at build time.
EXPO_PUBLIC_API_BASE_URL=https://flexipay.jamiuadewaleyusuf.com/api

# Certificate pinning (off by default, like the Flutter app).
# Flutter pinned a root-CA PEM; React Native pins SPKI public-key hashes
# (base64 SHA-256). Supply at least two (current + backup), comma-separated.
EXPO_PUBLIC_ENABLE_CERT_PINNING=false
EXPO_PUBLIC_PINNED_PUBLIC_KEY_HASHES=
