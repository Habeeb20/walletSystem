{
  "expo": {
    "name": "Flexi Pay",
    "slug": "flexi-pay",
    "scheme": "flexipay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.example.flexiPay",
      "supportsTablet": false
    },
    "android": {
      "package": "com.codequor.flexipay",
      "allowBackup": false,
      "permissions": ["android.permission.USE_BIOMETRIC"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "FlexiPay uses Face ID to let you log in and confirm payments securely without typing your password."
        }
      ],
      [
        "expo-build-properties",
        { "android": { "usesCleartextTraffic": false } }
      ]
    ]
  }
}
